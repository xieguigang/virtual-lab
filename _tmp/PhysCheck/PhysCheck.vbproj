<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PhysCheck</RootNamespace>
    <StartupObject>PhysCheck.Program</StartupObject>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\physics\Engine\PhysicsEngine.vbproj" />
    <ProjectReference Include="..\..\src\VirtualWorkshop\VirtualWorkshop.vbproj" />
  </ItemGroup>

</Project>
