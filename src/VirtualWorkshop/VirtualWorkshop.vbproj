<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>VirtualWorkshop.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Empty</MyType>
    <UseWPF>True</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>VirtualWorkshop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模型文件复制到输出目录，保证从任意工作目录启动都能加载 -->
    <None Include="..\..\models\six_axis_arm.glb" Link="models\six_axis_arm.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\six_axis_arm.urdf" Link="models\six_axis_arm.urdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\wooden_block.glb" Link="models\wooden_block.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\erlenmeyer_flask.glb" Link="models\erlenmeyer_flask.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Drawing-net4.8\Drawing-net4.8.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Landscape\Landscape.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\mime\text%html\html_netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\physics\Engine\PhysicsEngine.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\physics\Particles\Particles.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Drawing\src\DXApi\DXApi.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Drawing\src\DxCanvas\DxCanvas.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="My Project\Application.Designer.vb" />
    <None Remove="My Project\Application.myapp" />
  </ItemGroup>

</Project>