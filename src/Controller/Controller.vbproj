<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Controller</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>disable</Nullable>
    <StartupObject>Controller.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\mime\application%json\JSON-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\..\..\GCModeller\src\runtime\sciBASIC#\vs_solutions\JavaScript\LiteJs.vbproj" />
    <!-- LLM 接入（Ollama / OpenAI 兼容客户端） -->
    <ProjectReference Include="..\..\..\LLMs\src\Ollama\Ollama.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScript 演示脚本随输出复制 -->
    <None Include="scripts\*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
